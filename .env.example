# Slack App (SEN-18)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Anthropic / Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Notion remote MCP (SEN-20)
# OAuth token from https://developers.notion.com/docs/mcp
NOTION_MCP_TOKEN=...

# Linear remote MCP (SEN-21)
# OAuth token from https://linear.app/docs/mcp
LINEAR_MCP_TOKEN=...

# Vercel KV — thread state (SEN-19)
# Create at vercel.com/dashboard → Storage → Create KV Store
# Then run: vercel env pull .env.local  (auto-populates KV_URL and other KV vars)
KV_URL=rediss://default:TOKEN@hostname.kv.vercel-storage.com:6379
