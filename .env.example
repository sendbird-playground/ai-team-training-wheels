# Slack App (SEN-18)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Anthropic / Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Notion remote MCP (SEN-20)
# OAuth token from https://developers.notion.com/docs/mcp
NOTION_MCP_TOKEN=...

# Linear remote MCP (SEN-21)
# OAuth token from https://linear.app/docs/mcp
LINEAR_MCP_TOKEN=...

# Upstash Redis — thread state (SEN-19)
# Create a free instance at https://console.upstash.com
# Use the "Redis URL" (rediss://...) NOT the REST API URL
UPSTASH_REDIS_URL=rediss://default:TOKEN@hostname.upstash.io:6379
