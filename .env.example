# Slack App (SEN-18)
# Bot token and signing secret from api.slack.com/apps → your app → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Channel guard — only respond in this channel
# Right-click channel → View channel details → copy ID at the bottom
SLACK_ALLOWED_CHANNEL_ID=C0XXXXXXXXX

# Anthropic / Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Notion remote MCP (SEN-20)
# OAuth token from https://developers.notion.com/docs/mcp
NOTION_MCP_TOKEN=...

# Linear remote MCP (SEN-21)
# OAuth token from https://linear.app/docs/mcp
LINEAR_MCP_TOKEN=...

# Linear API key — used by /ship handler to fetch issues and post comments (SEN-25)
# Create at https://linear.app/settings/api → Personal API keys
LINEAR_API_KEY=lin_api_...

# Upstash Redis — thread state (SEN-19)
# Create via Vercel dashboard → Storage → Upstash, connect project
# Then run: vercel env pull .env.local  (auto-populates REDIS_URL)
REDIS_URL=rediss://default:TOKEN@hostname.upstash.io:6379
